# =====================================
# بيئة التطبيق
# =====================================
NODE_ENV=production
PORT=3000

# =====================================
# قاعدة البيانات PostgreSQL
# =====================================
DATABASE_URL=postgresql://username:password@hostname:5432/h-hr-db

# الخيارات:
# - محلي: postgresql://postgres:password@localhost:5432/h-hr-db
# - Neon (مستضاف): postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/h-hr-db?sslmode=require
# - Heroku: postgresql://user:password@ec2-xxx.compute-1.amazonaws.com:5432/database
# - Railway: postgresql://user:password@containers-us-west-xxx.railway.app:xxx/railway

# =====================================
# الأمان
# =====================================
# قائمة الدول الموثوقة للوصول (مفصولة بفواصل)
# مثال: http://localhost:3000,https://example.com,https://app.example.com
ALLOWED_ORIGINS=*

# =====================================
# بيانات الشركة الافتراضية
# =====================================
DEFAULT_COMPANY_NAME=Mura
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin@123

# =====================================
# إعدادات البريد الإلكتروني (اختياري)
# =====================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=noreply@h-hr.com
